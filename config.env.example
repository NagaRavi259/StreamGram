# Copy to config.env and fill in. config.env is git-ignored, never commit real values.

# --- Telegram
API_ID=
API_HASH=
BOT_TOKEN=
BIN_CHANNEL=-100          # private channel where forwarded files live
OWNER_ID=                 # owner user ids, space or comma separated
# OWNER_USERNAME=         # shown on startup only, cosmetic
# SESSION_NAME=streamgram   # Mongo database name and Pyrogram session file name
# SLEEP_THRESHOLD=60      # Pyrogram FloodWait auto-sleep threshold, in seconds
# WORKERS=3               # Pyrogram update-handler worker threads
# BANNED_CHANNELS=        # channel ids the bot leaves if it's added to them, space separated
# MULTI_TOKEN_1=          # extra bot tokens to share the streaming load
# MULTI_TOKEN_2=

# --- Web server
PORT=8080
WEB_SERVER_BIND_ADDRESS=0.0.0.0
FQDN=                     # public host name or IP used in links
# HAS_SSL=false           # true / false -- also controls whether http:// or https:// is used in links
# SSL_CERTFILE=           # set with SSL_KEYFILE to have uvicorn terminate HTTPS itself (self-signed
# SSL_KEYFILE=            # IP cert via scripts/generate_self_signed_cert.sh, or a real cert/key pair);
                          # leave both unset if a reverse proxy in front already handles TLS
# NO_PORT=false           # true to leave the port out of links
# PING_INTERVAL=1200      # Heroku/Railway only: self-ping period in seconds, to stay awake
# APP_NAME=               # Heroku/Railway only: used to build the public URL when FQDN is unset

# --- MongoDB
MONGO_SCHEMA=mongodb      # or mongodb+srv
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_HOST=127.0.0.1
MONGO_PORT=27017

# --- Access control
USER_GROUP_ID=            # chat whose members (and join requesters) may use the bot, e.g. -100123...
TRUSTED_USERS=            # ids that always have access, space or comma separated
# UPDATES_CHANNEL=        # force-subscribe channel username (optional)
# MY_PASS=                # enables /login password protection (optional); off unless set

# --- Logging
LOG_LEVEL=INFO            # DEBUG, INFO, WARNING or ERROR
# LOG_LIBS_LEVEL=WARNING  # pyrogram, uvicorn, motor ...
# LOG_DIR=logs
# LOG_MAX_MB=5            # size of each log file before it rotates
# LOG_BACKUPS=3           # rotated copies kept per file
